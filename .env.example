# Runtime & Hostinger Deployment
NODE_ENV="production"
PORT="3000"
APP_URL="https://yourdomain.com"

# Persistent Data Directory (recommended outside the deploy folder on Hostinger so updates never reset cases)
# Example on Hostinger: /home/u123456789/fullremove-data
DATA_DIR=""

# AES-256-GCM Master Encryption Key for Evidence Vault (set a strong random string in Hostinger hPanel)
VAULT_KEY=""

# Security Toggles for Production Launch
# Set ALLOW_DEMO_LOGIN="false" and configure SMTP below before opening to real clients
ALLOW_DEMO_LOGIN="true"
ALLOW_DEV_LOGIN_CODE="true"

# Hostinger / Custom SMTP OTP Email Delivery
# When SMTP_HOST, SMTP_USER, and SMTP_PASS are set, one-time login codes are sent by email and hidden from API responses
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@yourdomain.com"

WATCHLIST_INTERVAL_MINUTES="15"

# Optional AI key if integrating Gemini services
GEMINI_API_KEY=""
